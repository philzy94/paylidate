<?xml version="1.0"?>
<ruleset name="Paylidate"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Complexity limits for application code.</description>

    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties><property name="reportLevel" value="6"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties><property name="minimum" value="64"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties><property name="minimum" value="40"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties><property name="minimum" value="300"/></properties>
    </rule>
</ruleset>
