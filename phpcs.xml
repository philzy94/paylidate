<?xml version="1.0"?>
<ruleset name="Paylidate">
    <description>PSR-12 coding standard.</description>
    <arg name="colors"/>
    <arg value="p"/>
    <file>app/Providers</file>
    <file>app/Services/PaymentService.php</file>
    <file>bootstrap/app.php</file>
    <file>bootstrap/providers.php</file>
    <file>config</file>
    <file>database/factories</file>
    <file>database/seeders</file>
    <file>routes/web.php</file>
    <file>tests</file>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <severity>0</severity>
    </rule>
</ruleset>
