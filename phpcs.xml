<?xml version="1.0"?>
<ruleset name="Paylidate">
    <description>PSR-12 coding standard.</description>
    <arg name="colors"/>
    <arg value="p"/>
    <file>app</file>
    <file>bootstrap/app.php</file>
    <file>bootstrap/providers.php</file>
    <file>config</file>
    <file>database/factories</file>
    <file>database/seeders</file>
    <file>routes</file>
    <file>tests</file>
    <rule ref="PSR12"/>
    <!-- Legacy public API handlers use snake_case names referenced by routes. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <severity>0</severity>
    </rule>
    <rule ref="PSR12.Properties.ConstantVisibility">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <severity>0</severity>
    </rule>
</ruleset>
